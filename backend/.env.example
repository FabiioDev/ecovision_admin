# Copia este archivo como backend/.env para desarrollo local. NUNCA commitees .env.
# En Cloud Run estas variables se pasan con --set-env-vars / --set-secrets.

# Routers montados: all | api | admin
ROLE=all

# Proyecto de GCP/Firebase (Firestore y Firebase Auth)
GOOGLE_CLOUD_PROJECT=tu-proyecto-id

# Clave para firmar la cookie de sesión del panel (mín. 32 caracteres).
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# En producción va en Secret Manager, no aquí.
SECRET_KEY=

# En local (http) pon false; en Cloud Run (https) debe ser true
COOKIE_SECURE=false

# Duración de la sesión del panel en segundos (8 h)
SESSION_MAX_AGE_S=28800

# Límite de intentos de login: N fallos en la ventana bloquea usuario e IP
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_S=900

# Segundos que /api/v1/config se sirve desde memoria antes de releer Firestore
CONFIG_CACHE_TTL_S=30

# Exigir token de Firebase en GET /api/v1/config (activar en la Fase 3)
CONFIG_REQUIRE_AUTH=false

# Mostrar /docs y /openapi.json de FastAPI (solo desarrollo)
DOCS_ENABLED=false

LOG_LEVEL=INFO

# --- Servicio de inferencia (demo /demo y /api/v1/predict) ---
# URL base del servicio de Cloud Run del modelo, sin barra final. Vacía = sin modelo
# (/predict responde 503 y /api/v1/health indica inferencia "sin_configurar").
INFERENCE_URL=
# Enviar ID token de Google (audiencia = INFERENCE_URL). Obligatorio con la inferencia
# privada. En local sin cuenta de servicio se llama sin token (solo sirve si es pública).
INFERENCE_USE_ID_TOKEN=true
# TOPE de espera a la inferencia (s). La espera real sale de la flag request_timeout_s
# del panel menos 3 s; debe quedar por debajo de los 120 s del servicio de inferencia.
INFERENCE_TIMEOUT_S=115

# --- Descarga del APK (/descargar). Además debe activarse la flag download_enabled ---
# Redirecciones al APK de GitHub permitidas por IP en la ventana (segundos)
DOWNLOAD_RATE_LIMIT=10
DOWNLOAD_RATE_WINDOW_S=600

# --- POST /api/v1/predict (app) ---
# Tamaño máximo de la imagen (la app envía JPEG 640x640, < 1 MB)
PREDICT_MAX_UPLOAD_MB=5
# Detecciones permitidas por usuario en la ventana (segundos), por instancia
PREDICT_RATE_LIMIT=20
PREDICT_RATE_WINDOW_S=60

# --- Demo web pública (/demo). Además debe activarse la flag demo_enabled en el panel ---
DEMO_MAX_UPLOAD_MB=5
# Análisis permitidos por IP en la ventana (segundos)
DEMO_RATE_LIMIT=10
DEMO_RATE_WINDOW_S=60
# Tope de análisis por instancia y hora (limita el gasto)
DEMO_HOURLY_LIMIT=300

# Opcional: emuladores locales de Firebase
# FIRESTORE_EMULATOR_HOST=localhost:8085
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
